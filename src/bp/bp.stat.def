DEF_STAT(  BTB_L1_CORRECT_OFFPATH,                      DIST, NO_RATIO  )
DEF_STAT(  BTB_L1_INCORRECT_BUT_TARGET_CORRECT_OFFPATH, COUNT, NO_RATIO  )
