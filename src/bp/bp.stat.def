DEF_STAT(  BTB_MAIN_INCORRECT,                    DIST, NO_RATIO  )

DEF_STAT(  BTB_L0_CORRECT_OFFPATH,                      DIST, NO_RATIO  )
DEF_STAT(  BTB_L0_INCORRECT_BUT_TARGET_CORRECT_OFFPATH, COUNT, NO_RATIO  )
DEF_STAT(  BTB_L0_INCORRECT_TAG_ALIAS_OFFPATH,          COUNT, NO_RATIO  )
